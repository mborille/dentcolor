{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doi.org/10.6084/m9.figshare.33087674/shade-table.schema.json",
  "title": "Tabela de escala de cor odontológica",
  "description": "Formato para publicar coordenadas CIELAB de uma escala de cor odontológica de modo reprodutível. O bloco 'provenance' é obrigatório: uma tabela sem procedência declarada não é citável.",
  "type": "object",
  "required": ["name", "provenance", "shades"],
  "properties": {
    "name": { "type": "string", "description": "Nome da escala, ex.: 'VITA Classical A1-D4'." },
    "manufacturer": { "type": "string" },
    "version": { "type": "string" },
    "provenance": {
      "type": "object",
      "description": "De onde vieram os números. Sem isto, a tabela é ilustrativa e não referencial.",
      "required": ["status", "method"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["measured", "published", "provisional", "estimated"],
          "description": "measured = medido pelo autor; published = transcrito de fonte citada; provisional = origem não rastreada, NÃO CITÁVEL; estimated = interpolado ou estimado, NÃO CITÁVEL."
        },
        "method": { "type": "string", "description": "Como foi obtido, em uma frase." },
        "instrument": { "type": "string", "description": "Espectrofotômetro ou colorímetro, com modelo." },
        "illuminant": { "type": "string", "default": "D65" },
        "observer": { "type": "string", "default": "2deg" },
        "geometry": { "type": "string", "description": "Geometria de medição, ex.: 'd/8, SCI'." },
        "backing": { "type": "string", "description": "Fundo usado na medição." },
        "replicates": { "type": "integer", "minimum": 1, "description": "Leituras por tab." },
        "source_citation": { "type": "string", "description": "Referência completa quando status = published." },
        "source_doi": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "shades": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "L", "a", "b"],
        "properties": {
          "name": { "type": "string" },
          "group": { "type": "string" },
          "L": { "type": "number", "minimum": 0, "maximum": 100 },
          "a": { "type": "number" },
          "b": { "type": "number" },
          "sd_L": { "type": "number", "minimum": 0, "description": "Desvio padrão de L*. Publique sempre que status = measured." },
          "sd_a": { "type": "number", "minimum": 0 },
          "sd_b": { "type": "number", "minimum": 0 },
          "n": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
